NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
PERSISTENCE=json
AUTH_PERSISTENCE=mongodb
JSON_DATA_DIRECTORY=./src/database/json/data
# Development/test falls back to in-memory auth if MongoDB is unavailable.
# Production requires an authenticated, TLS-enabled MongoDB URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=exampro
JWT_ACCESS_SECRET=change-this-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-this-to-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
